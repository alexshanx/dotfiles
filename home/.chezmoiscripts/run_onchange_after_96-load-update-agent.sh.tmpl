{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# (Re)load the weekly dotfiles-update LaunchAgent.
# Re-runs when the agent definition changes.
# LaunchAgent hash: {{ include "Library/LaunchAgents/io.github.alexshanx.dotfiles-update.plist.tmpl" | sha256sum }}

set -eu

label="io.github.alexshanx.dotfiles-update"
plist="{{ .chezmoi.homeDir }}/Library/LaunchAgents/${label}.plist"
domain="gui/$(id -u)"

# Booting out the agent from inside its own run would kill that run.
# launchd loads the updated definition at the next login instead.
if [ "${DOTFILES_UPDATE_AGENT:-}" = "1" ]; then
  echo "[INFO] ${label} changed; it reloads at next login"
  exit 0
fi

mkdir -p "{{ .chezmoi.homeDir }}/Library/Logs"
launchctl bootout "${domain}/${label}" 2>/dev/null || true
launchctl bootstrap "${domain}" "${plist}"
echo "[INFO] Loaded ${label} (weekly, Monday 10:30)"
{{- end }}

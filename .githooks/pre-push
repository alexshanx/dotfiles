#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Push blocked: install gitleaks with 'brew install gitleaks'." >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

while read -r local_ref local_oid remote_ref remote_oid; do
  # A zero local object ID denotes a remote ref deletion.
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac

  if ! git rev-parse --verify "$local_oid^{commit}" >/dev/null 2>&1; then
    echo "Push blocked: cannot scan non-commit ref $local_ref." >&2
    exit 1
  fi

  if git rev-parse --verify "$remote_oid^{commit}" >/dev/null 2>&1; then
    range="$remote_oid..$local_oid"
  else
    # New refs or unavailable remote objects require scanning the full history.
    range="$local_oid"
  fi

  echo "Scanning outgoing commits for $remote_ref..." >&2
  gitleaks git --config .gitleaks.toml --redact --log-opts="$range" .
done

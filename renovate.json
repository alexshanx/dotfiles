{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "mode": "full",
  "enabledManagers": [
    "proto"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": [
    "* * 1-3 * *"
  ],
  "minimumReleaseAge": "14 days",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "rebaseWhen": "behind-base-branch",
  "proto": {
    "managerFilePatterns": [
      "/^home\\/dot_proto\\/dot_prototools$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group proto toolchain updates into one pull request for manual review",
      "matchManagers": [
        "proto"
      ],
      "groupName": "proto toolchain",
      "groupSlug": "proto-toolchain",
      "automerge": false
    },
    {
      "description": "Keep Node.js on the configured release line",
      "matchManagers": [
        "proto"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}

#!/bin/sh
# Bring this machine up to date with the dotfiles repository and upstream tools:
#   1. Pull the dotfiles (fast-forward only), show the incoming commits and the
#      pending changes, and apply them only after confirmation. This picks up
#      reviewed Renovate updates to ~/.proto/.prototools and Brewfile changes.
#   2. Show the proto status, then upgrade proto itself and install every
#      pinned proto tool after confirmation; optionally clean stale tools.
#   3. Show outdated Homebrew formulae and upgrade them after confirmation
#      (casks are left to their own updaters).
#
# Run it by hand from a terminal. Nothing is upgraded without a "y" answer.
# Each step runs even if an earlier one fails; failures are summarized at the end.

set -u

export PROTO_HOME="${PROTO_HOME:-${HOME}/.proto}"
export PATH="${PROTO_HOME}/shims:${PROTO_HOME}/bin:${PATH}"

FAILED_STEPS=""

log() {
  printf '[%s] [%s] %s\n' "$(date '+%H:%M:%S')" "$1" "$2"
}

step() {
  name="$1"
  shift
  log "INFO" "${name}: $*"
  if "$@"; then
    log "INFO" "${name}: done"
  else
    log "ERROR" "${name}: failed"
    FAILED_STEPS="${FAILED_STEPS} ${name}"
  fi
}

confirm() {
  printf '%s [y/N] ' "$1"
  read -r answer </dev/tty || return 1
  case "${answer}" in
    [yY] | [yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

update_dotfiles() {
  before="$(chezmoi git -- rev-parse HEAD)" || return 1
  chezmoi git -- pull --ff-only || return 1
  after="$(chezmoi git -- rev-parse HEAD)" || return 1

  if [ "${before}" != "${after}" ]; then
    log "INFO" "Incoming commits:"
    chezmoi git -- log --oneline "${before}..${after}"
  fi

  if [ -z "$(chezmoi diff --no-pager)" ]; then
    log "INFO" "Dotfiles already applied"
    return 0
  fi

  # Shows changed files and the scripts that apply would run.
  chezmoi diff
  if ! confirm "Apply these dotfile changes?"; then
    log "WARNING" "Dotfile changes left unapplied"
    return 0
  fi
  chezmoi apply
}

update_proto() {
  # Pinned versions come from the reviewed ~/.proto/.prototools.
  proto status --config-mode global
  # proto itself cannot be pinned; this shows the latest release.
  proto upgrade --check || true
  if ! confirm "Upgrade proto and install the pinned tools?"; then
    log "WARNING" "proto toolchain left unchanged"
    return 0
  fi
  proto upgrade --yes || return 1
  # global mode reads only ~/.proto/.prototools, independent of the working directory.
  proto install --config-mode global --yes || return 1

  if confirm "Remove proto tools and plugins unused for 30 days?"; then
    proto clean --yes || return 1
  fi
}

update_brew() {
  brew update || return 1
  outdated="$(brew outdated --formula --verbose)" || return 1
  if [ -z "${outdated}" ]; then
    log "INFO" "Homebrew formulae already up to date"
    return 0
  fi

  printf '%s\n' "${outdated}"
  if [ "$(uname -m)" = "x86_64" ]; then
    log "WARNING" "Homebrew no longer builds bottles for Intel Macs; upgrades and new dependencies may compile from source and take hours"
  fi
  if ! confirm "Upgrade these Homebrew formulae and their dependencies?"; then
    log "WARNING" "Homebrew formulae left unchanged"
    return 0
  fi
  brew upgrade --formula || return 1
  brew cleanup
}

if [ ! -t 0 ] || [ ! -t 1 ]; then
  log "ERROR" "Run dotfiles-update from an interactive terminal"
  exit 1
fi

log "INFO" "Starting update"

if command -v chezmoi >/dev/null 2>&1; then
  step "dotfiles" update_dotfiles
else
  log "WARNING" "chezmoi not found; skipping dotfiles"
fi

if command -v proto >/dev/null 2>&1; then
  step "proto" update_proto
else
  log "WARNING" "proto not found; skipping toolchain"
fi

if command -v brew >/dev/null 2>&1; then
  step "brew" update_brew
else
  log "WARNING" "Homebrew not found; skipping packages"
fi

if [ -n "${FAILED_STEPS}" ]; then
  log "ERROR" "Finished with failures:${FAILED_STEPS}"
  exit 1
fi

log "INFO" "Finished successfully"
